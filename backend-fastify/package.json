{
  "name": "mangadex-reader-backend",
  "version": "1.0.0",
  "main": "app.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.9.0"
  },
  "directories": {
    "test": "test"
  },
  "scripts": {
    "start": "pnpm run build && node dist/server.js",
    "build": "tsc",
    "watch": "tsc -w",
    "dev": "pnpm run build && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"pnpm:watch\" \"pnpm:dev:start\"",
    "dev:start": "pnpm run build && node --watch dist/server.js",
    "warm-cache": "tsx src/scripts/warmCache.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:db:up": "docker compose -f ../docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f ../docker-compose.test.yml down -v",
    "test:db:migrate": "DATABASE_URL=postgresql://kevin:password@localhost:5435/manga_test prisma migrate deploy"
  },
  "keywords": [],
  "author": "KevinLmn",
  "license": "ISC",
  "packageManager": "pnpm@10.11.0",
  "inject-workspace-packages": true,
  "dependencies": {
    "@manga/shared-types": "workspace:*",
    "@aws-sdk/client-s3": "^3.850.0",
    "@fastify/autoload": "^6.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/env": "^5.0.2",
    "@fastify/error": "^4.2.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/postgres": "^6.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.3",
    "@fastify/static": "^8.2.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/type-provider-typebox": "^5.1.0",
    "@fastify/under-pressure": "^9.0.3",
    "@prisma/client": "^6.7.0",
    "@sinclair/typebox": "^0.34.33",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "argon2id": "^1.0.1",
    "axios": "^1.9.0",
    "bcrypt": "^6.0.0",
    "close-with-grace": "^2.2.0",
    "concurrently": "^9.1.2",
    "csv-stringify": "^6.5.2",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.3.3",
    "fastify-cli": "^7.4.0",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.8.2",
    "jest": "^30.2.0",
    "mime-types": "^3.0.1",
    "sharp": "^0.34.3",
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.15.29",
    "@types/pg": "^8.15.4",
    "@vitest/coverage-v8": "^4.1.5",
    "fastify-tsconfig": "^3.0.0",
    "form-data": "^4.0.2",
    "ioredis-mock": "^8.13.1",
    "prisma": "^6.7.0",
    "typescript": "~5.8.3",
    "vitest": "^4.1.5"
  }
}
