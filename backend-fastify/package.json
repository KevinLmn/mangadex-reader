{
  "name": "qcm-admin-api",
  "version": "1.0.0",
  "description": "A simple Fastify API for QCM (Questionnaire à Choix Multiples)",
  "main": "app.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.9.0"
  },
  "directories": {
    "test": "test"
  },
  "scripts": {
    "start": "pnpm run build && fastify start -l info dist/app.js",
    "build": "tsc",
    "watch": "tsc -w",
    "dev": "pnpm run build && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"pnpm:watch\" \"pnpm:dev:start\"",
    "dev:start": "pnpm run build && fastify start --ignore-watch=.ts$ -w -l info -P dist/app.js",
    "test": "pnpm run db:seed && pnpm run test:run",
    "test:run": "jest --config tests/jest.config.ts --coverage --testPathIgnorePatterns=/test/",
    "standalone": "pnpm run build && node --env-file=.env dist/server.js",
    "lint": "eslint --ignore-pattern=dist",
    "lint:fix": "pnpm run lint -- --fix",
    "db:create": "tsx --env-file=.env ./scripts/create-database.ts",
    "db:drop": "tsx --env-file=.env ./scripts/drop-database.ts",
    "db:migrate": "tsx --env-file=.env ./scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env ./scripts/seed-database.ts",
    "db:seed:incremental": "tsx --env-file=.env ./scripts/seed-incremental.ts",
    "clean": "rm -rf dist",
    "db:reset": "pnpm db:drop && pnpm db:create && pnpm db:migrate && pnpm db:seed && pnpm db:seed:incremental"
  },
  "keywords": [],
  "author": "Matthieu COUPPEY <m.couppey@qualit-enr.org>",
  "license": "ISC",
  "packageManager": "pnpm@10.11.0",
  "inject-workspace-packages": true,
  "dependencies": {
    "@aws-sdk/client-s3": "^3.850.0",
    "@fastify/autoload": "^6.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/env": "^5.0.2",
    "@fastify/error": "^4.2.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/postgres": "^6.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.3",
    "@fastify/static": "^8.2.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/type-provider-typebox": "^5.1.0",
    "@fastify/under-pressure": "^9.0.3",
    "@sinclair/typebox": "^0.34.33",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "argon2id": "^1.0.1",
    "bcrypt": "^6.0.0",
    "close-with-grace": "^2.2.0",
    "concurrently": "^9.1.2",
    "csv-stringify": "^6.5.2",
    "date-fns": "^4.1.0",
    "fastify": "^5.3.3",
    "fastify-cli": "^7.4.0",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.8.2",
    "@prisma/client": "^6.7.0",
    "jest": "^30.2.0",
    "mime-types": "^3.0.1",
    "sharp": "^0.34.3",
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.15.29",
    "@types/pg": "^8.15.4",
    "fastify-tsconfig": "^3.0.0",
    "form-data": "^4.0.2",
    "prisma": "^6.7.0",
    "typescript": "~5.8.3"
  }
}
