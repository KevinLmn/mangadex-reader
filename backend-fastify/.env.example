# Database (from Docker - use postgres hostname inside container)
DATABASE_URL=postgresql://kevin:password@postgres:5432/manga

# Server
PORT=3012

# MangaDex API
MANGADEX_USERNAME=your_mangadex_username
MANGADEX_PASSWORD=your_mangadex_password
MANGADEX_CLIENT_ID=your_client_id
MANGADEX_CLIENT_SECRET=your_client_secret
MANGADEX_BASE_URL=https://api.mangadex.org
MANGADEX_REFRESH_TOKEN_URL=https://auth.mangadex.org/realms/mangadex/protocol/openid-connect/token

# Frontend URL
FRONT_END_URL=http://localhost:3011

# Redis (use redis hostname inside container)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Cookie
COOKIE_SECRET=change-this-to-a-secure-random-string-32chars
COOKIE_NAME=mangadex_session
COOKIE_SECURED=false

# Rate Limiting
RATE_LIMIT_MAX=100

# JWT
JWT_SECRET=change-this-to-another-secure-random-string-32chars
